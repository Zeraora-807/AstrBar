<Window x:Class="AstrBar.Views.ChatPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AstrBar.Models"
        Title="AstrBar"
        Width="470"
        Height="540"
        MinWidth="400"
        MinHeight="380"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing">
    <Window.Resources>
        <DataTemplate DataType="{x:Type models:TextMessagePart}">
            <TextBlock Text="{Binding Text}"
                       TextWrapping="Wrap"
                       FontFamily="Segoe UI, Microsoft YaHei UI"
                       FontSize="13.5"
                       Foreground="{Binding DataContext.TextBrush, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:AttachmentMessagePart}">
            <StackPanel Margin="0,5,0,1">
                <Border MaxWidth="330"
                        Padding="6"
                        CornerRadius="10"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        MouseLeftButtonUp="ImageAttachment_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Image Source="{Binding PreviewSource}"
                               MaxWidth="310"
                               MaxHeight="240"
                               Stretch="Uniform"
                               Cursor="Hand">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewSource}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="16">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewSource}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="▧"
                                       HorizontalAlignment="Center"
                                       FontSize="28"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="{Binding StatusText}"
                                       Margin="0,6,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Padding="10"
                        CornerRadius="10"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCard}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36"
                                Height="36"
                                CornerRadius="10"
                                Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="{Binding IconText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="18"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                            <TextBlock Text="{Binding DisplayName}"
                                       MaxWidth="190"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StatusText}"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Margin="0,0,0,4"
                                    Padding="9,5"
                                    Content="Download"
                                    Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Click="DownloadAttachment_Click"/>
                            <Button Margin="0,0,0,4"
                                    Padding="9,5"
                                    Content="Open"
                                    Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Click="OpenAttachment_Click"/>
                            <Button Padding="9,5"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Content="Save As"
                                    Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Click="SaveAttachment_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PendingAttachmentTemplate" DataType="{x:Type models:PendingUploadAttachment}">
            <Border Margin="0,0,7,6"
                    Padding="7"
                    CornerRadius="9"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="7"
                            Background="{DynamicResource AccentSoftBrush}">
                        <Image Source="{Binding PreviewSource}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="7,0,5,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}"
                                   MaxWidth="150"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding SizeText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Width="26"
                            Height="26"
                            Padding="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="RemovePendingAttachment_Click"
                            Content="×"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="10"
            CornerRadius="16"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="14,11"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="9"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="✦" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="White" FontSize="16"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AstrBar"
                                   FontFamily="Segoe UI Semibold, Microsoft YaHei UI"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Ready"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButtonStyle}" ToolTip="Orb"
                                Click="CollapseToOrbButton_Click" Content="●" FontSize="12"/>
                        <Button Style="{StaticResource GhostButtonStyle}" ToolTip="Settings"
                                Click="SettingsButton_Click" Content="⚙"/>
                        <Button Style="{StaticResource GhostButtonStyle}" ToolTip="Minimize"
                                Click="HideButton_Click" Content="×" FontSize="18"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="12,10,12,0">
                <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MessagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border HorizontalAlignment="{Binding BubbleAlignment}"
                                        MaxWidth="360"
                                        Margin="0,4"
                                        Padding="11,8"
                                        CornerRadius="11"
                                        Background="{Binding BubbleBackground}">
                                    <ItemsControl ItemsSource="{Binding Parts}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyHint"
                           Text="What'd you like to talk?"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"
                           LineHeight="22"/>
            </Grid>

            <Border Grid.Row="2"
                    Margin="12"
                    Padding="8"
                    CornerRadius="12"
                    Background="{DynamicResource InputBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    AllowDrop="True"
                    DragOver="Composer_DragOver"
                    Drop="Composer_Drop">
                <StackPanel>
                    <ItemsControl x:Name="PendingAttachmentsList"
                                  Visibility="Collapsed"
                                  ItemTemplate="{StaticResource PendingAttachmentTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AttachButton"
                                Width="38"
                                Height="36"
                                Padding="0"
                                Margin="0,0,7,0"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource GhostButtonStyle}"
                                ToolTip="Add Attachment"
                                Click="AttachButton_Click"
                                Content="＋"
                                FontSize="20"/>
                        <ComboBox x:Name="SendModeInput"
                                  Grid.Column="1"
                                  Width="96"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Bottom"
                                  SelectedIndex="0"
                                  Style="{StaticResource AstrBarComboBoxStyle}"
                                  ToolTip="自动:自动识别消息类型">
                            <ComboBoxItem Content="自动"/>
                            <ComboBoxItem Content="对话"/>
                            <ComboBoxItem Content="命令"/>
                        </ComboBox>
                        <TextBox x:Name="MessageInput"
                                 Grid.Column="2"
                                 MinHeight="40"
                                 MaxHeight="100"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 KeyDown="MessageInput_KeyDown"
                                 ToolTip="Ctrl + Enter 发送， Enter 换行"/>
                        <Button x:Name="SendButton"
                                Grid.Column="3"
                                Margin="8,0,0,0"
                                MinWidth="64"
                                VerticalAlignment="Bottom"
                                Click="SendButton_Click"
                                Content="Send"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
