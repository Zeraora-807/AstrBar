<Window x:Class="AstrBar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AstrBar 设置"
        Width="650"
        Height="760"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="AstrBar 设置"
                       FontFamily="Segoe UI Semibold, Microsoft YaHei UI"
                       FontSize="22"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Margin="0,5,0,0"
                       Text="连接、聊天、外观和系统行为都在这里。"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <TabControl Grid.Row="1"
                    Margin="0,18,0,16"
                    Style="{StaticResource AstrBarSettingsTabControlStyle}">
            <TabItem Header="连接">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <CheckBox x:Name="UseTunnelInput"
                                  Margin="0,0,0,12"
                                  Content="使用 AstrBar 内置 SSH 隧道（推荐）"
                                  Checked="UseTunnelInput_Changed"
                                  Unchecked="UseTunnelInput_Changed"/>

                        <Grid x:Name="TunnelSettingsPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="服务器公网 IP 或域名" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox x:Name="SshHostInput" Margin="0,6,0,12"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="SSH 端口" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox x:Name="SshPortInput" Margin="0,6,0,12"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="SSH 用户名" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox x:Name="SshUsernameInput" Margin="0,6,0,12"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="SSH 密码" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <PasswordBox x:Name="SshPasswordInput" Margin="0,6,0,12"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="AstrBot 服务器端口" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox x:Name="RemotePortInput" Margin="0,6,0,12"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="本地转发端口" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox x:Name="LocalPortInput" Margin="0,6,0,12"/>
                            </StackPanel>

                            <CheckBox x:Name="AutoReconnectInput"
                                      Grid.Row="3"
                                      Grid.ColumnSpan="3"
                                      Margin="0,2,0,12"
                                      Content="隧道断开后自动重连"/>

                            <Border Grid.Row="4"
                                    Grid.ColumnSpan="3"
                                    Padding="11"
                                    CornerRadius="9"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <StackPanel>
                                    <TextBlock Text="SSH 主机指纹"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="FingerprintText"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Button Width="120"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Click="ResetFingerprintButton_Click"
                                            Content="重新信任主机"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="DirectSettingsPanel" Visibility="Collapsed">
                            <TextBlock Text="AstrBot 地址" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="BaseUrlInput" Margin="0,6,0,12"/>
                        </StackPanel>

                        <TextBlock Margin="0,16,0,0"
                                   Text="API Key（需要 chat 与 file scope）"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <PasswordBox x:Name="ApiKeyInput" Margin="0,6,0,12"/>

                        <Button x:Name="TestButton"
                                Width="150"
                                HorizontalAlignment="Left"
                                Click="TestButton_Click"
                                Content="测试并重连"/>
                        <TextBlock x:Name="TestStatusText"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="聊天">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="username" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox x:Name="UsernameInput" Margin="0,6,0,14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="session_id" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox x:Name="SessionIdInput" Margin="0,6,0,14"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="完整 LLM 唤醒前缀（可留空）"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="WakePrefixInput" Margin="0,6,0,4"/>
                        <TextBlock Margin="0,0,0,14"
                                   Text="普通对话自动补此前缀，插件命令保持原样。"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <TextBlock Text="插件命令前缀"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="CommandPrefixesInput" Margin="0,6,0,4"/>
                        <TextBlock Text="多个前缀用逗号分隔，例如 /,!"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="外观">
                <StackPanel Margin="14">
                    <TextBlock Text="界面配色" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="ThemeInput"
                              Margin="0,6,0,16"
                              Style="{StaticResource AstrBarComboBoxStyle}"
                              ItemTemplate="{StaticResource ThemeOptionTemplate}"
                              SelectionChanged="ThemeInput_SelectionChanged"/>

                    <TextBlock Text="悬浮球配色" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="OrbColorInput"
                              Margin="0,6,0,16"
                              Style="{StaticResource AstrBarComboBoxStyle}"
                              ItemTemplate="{StaticResource OrbColorOptionTemplate}"
                              SelectionChanged="ThemeInput_SelectionChanged"/>

                    <CheckBox x:Name="KeepTopmostInput"
                              Margin="0,5"
                              Content="对话栏始终置顶"/>
                    <CheckBox x:Name="OrbSnapInput"
                              Margin="0,5"
                              Content="悬浮球拖动后吸附屏幕边缘"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="系统">
                <StackPanel Margin="14">
                    <CheckBox x:Name="NotifyOnCompleteInput"
                              Margin="0,5"
                              Content="窗口未激活时，用 Windows 通知提示回复完成"/>
                    <CheckBox x:Name="StartWithWindowsInput"
                              Margin="0,5"
                              Content="登录 Windows 时自动启动 AstrBar"/>
                    <Border Margin="0,18,0,0"
                            Padding="12"
                            CornerRadius="10"
                            Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="配置文件位于 LocalAppData\AstrBar。API Key 与 SSH 密码使用 Windows DPAPI 加密，不保存在程序文件夹。"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SaveStatusText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="82"
                        Margin="0,0,8,0"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="CancelButton_Click"
                        Content="取消"/>
                <Button x:Name="SaveButton"
                        Width="100"
                        Click="SaveButton_Click"
                        Content="保存并应用"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
